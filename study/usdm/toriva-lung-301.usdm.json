                "name": "OBJ-S1",
                "label": "Secondary objective S1 - PFS",
                "text": "To compare Progression-Free Survival (PFS) between the torivumab and placebo arms as assessed by blinded independent central review (BICR) per RECIST 1.1.",
                "description": "Protocol synopsis section 2.2, secondary objective 1. SAP section 2.2 S1 adds the null hypothesis PFS HR = 1.",
                "instanceType": "Objective",
                "level": {
                  "id": "Code_OL2",
                  "code": "C85827",
