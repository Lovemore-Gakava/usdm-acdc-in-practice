                  {
                    "id": "Endpoint_OS",
                    "name": "END-OS",
                    "label": "Overall Survival",
                    "text": "Time from randomisation to death from any cause. Subjects not known to have died at data cut-off are censored at the date last known alive.",
                    "description": "Protocol synopsis section 6, endpoint definitions. SAP section 4.1.",
                    "purpose": "Primary efficacy",
                    "instanceType": "Endpoint",
                    "level": {
                      "id": "Code_EL1",
                      "code": "C94496",
