                "id": "Objective_1",
                "name": "OBJ1",
                "label": "Primary objective - OS",
                "text": "To evaluate the effect of torivumab 200 mg Q3W versus placebo on Overall Survival (OS) in patients with previously untreated advanced or metastatic NSCLC with PD-L1 TPS >= 50% and no EGFR or ALK genomic tumour aberrations.",
                "description": "Protocol synopsis section 2.1. The SAP restates this at section 2.1 with the null hypothesis: OS hazard ratio (torivumab / placebo) = 1.",
                "instanceType": "Objective",
                "level": {
                  "id": "Code_OL1",
                  "code": "C85826",
                  "codeSystem": "http://www.cdisc.org",
                  "codeSystemVersion": "2024-09-27",
                  "decode": "Primary Objective",
                  "instanceType": "Code"
                },
